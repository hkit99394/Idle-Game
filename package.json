{
  "name": "path-of-neon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "vite-node tools/simulateBattle.ts",
    "support-decision": "vite-node tools/supportDecision.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run simulate && npm run support-decision && git diff --check"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
